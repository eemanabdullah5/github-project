# Copy this file to .env and fill in real values. Never commit .env.

# GitHub fine-grained token: read-only Contents + Metadata
GITHUB_TOKEN=

# Which AI service to use (DECISIONS D16):
#   gemini — Google's Gemini API. Fast, but repo code is sent to Google.
#   ollama — Qwen running locally in Ollama. Code stays on this machine.
LLM_PROVIDER=gemini

# --- Gemini (when LLM_PROVIDER=gemini) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Ollama (when LLM_PROVIDER=ollama) ---
OLLAMA_HOST=http://127.0.0.1:11434

# Models. Leave empty to use the defaults for Gemini
# (gemini-3.6-flash and gemini-embedding-001). Required for Ollama,
# e.g. CHAT_MODEL=qwen2.5-coder:3b and EMBED_MODEL=qwen3-embedding:0.6b
CHAT_MODEL=
EMBED_MODEL=

# Hybrid search: when a question names something in the code (e.g. `formatChunk`), also search by keyword.
# On by default. Set to "off" to use meaning (vector) search only.
HYBRID_SEARCH=on

# Folder summaries: while indexing, write a short AI summary of each folder for big-picture questions.
# On by default (uses a few extra chat calls per index). Set to "off" to skip them.
FOLDER_SUMMARIES=on
